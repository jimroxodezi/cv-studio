# ---- required ----
# Local dev: `docker compose up -d db` exposes Postgres on host port 5434.
# Inside Docker the compose file overrides this with `db:5432`.
DATABASE_URL=postgres://cv:cv@localhost:5434/cv
# openssl rand -base64 48
AUTH_SECRET=
# openssl rand -base64 32  (32-byte key for AES-256-GCM)
ENCRYPTION_KEY=
# Public URL, no trailing slash. Used in email links and origin checks.
# Behind Tailscale Funnel set this to the Funnel address, e.g.
# https://machine.tailnet.ts.net — it is the fallback when a request arrives
# without forwarded headers.
APP_URL=http://localhost:3000

# ---- bootstrap ----
# The first time this email signs in, it becomes the admin.
ADMIN_EMAIL=you@example.com
# Allow anyone to create an account. Leave false for invite-only.
ALLOW_OPEN_SIGNUP=false

# ---- AI ----
# Server default key. Users can override with their own key in Settings.
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini
# Optional: for OpenAI-compatible gateways.
DEFAULT_LLM_BASE_URL=
# Generations per user per day when the server key is used.
FREE_GENERATIONS_PER_DAY=5

# ---- email ----
# If SMTP_HOST is empty, sign-in links are printed to the server log and shown
# in the UI outside production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=CV Studio <no-reply@example.com>

# ---- LaTeX ----
# How many PDF compilations may run at once. Keep 1 on a 512 MB–1 GB host.
LATEX_MAX_CONCURRENCY=1
